<launch>

    <arg name="rviz_putn" default="false" />
    <arg name="use_sim_time" default="false" />
    <arg name="mapping_line_resolution" default="0.055" />
    <arg name="mapping_plane_resolution" default="0.05" />
    <arg name="mapping_skip_frame" default="1" />

    <param name="use_sim_time" value="$(arg use_sim_time)" />

    <!-- <node pkg="tf" type="static_transform_publisher" name="glim_map_to_putn_world" args="0 0 0 0 0 0 /map /world 10" /> -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="putn_world_to_putn_camera_init"
      args="0 0 0 0 0 0 world camera_init" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="putn_aft_mapped_to_base_link"
        args="0 0 0 0 0 0 aft_mapped base_link" />

    <node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator">
        <remap from="~goal" to="/goal" />
        <param name="waypoint_type" value="manual-lonely-waypoint" />
    </node>

    <node pkg="putn" type="global_planning_node" name="global_planning_node" output="log"
        required="true">
        <remap from="~waypoints" to="/waypoint_generator/waypoints" />
        <remap from="~map" to="/glim_ros/map" />

        <rosparam command="load" file="$(find putn)/config/for_real_scenarios/forest.yaml" />
    </node>

    <node pkg="putn" type="local_obs_node" name="local_obs_node" output="log" required="true">
        <remap from="~map" to="/hesai/points" />
        <param name="map/resolution" value="0.3" />
        <param name="map/local_x_l" value="-8.0" />  <!-- Expanded from -5 to catch context -->
        <param name="map/local_x_u" value="8.0" />
        <param name="map/local_y_l" value="-8.0" />
        <param name="map/local_y_u" value="8.0" />
        <!-- FIX: Lower the z_l to -1.0m so the ground at -0.5m is fully captured -->
        <param name="map/local_z_l" value="-2.0" /> 
        <param name="map/local_z_u" value="1.0" />
    </node>

    <node pkg="gpr" type="gpr_path" name="gpr_path" output="log" required="true">
        <param name="file/cfg_path" type="string" value="$(find gpr)/config/hyperparam.txt" />
    </node>

    <group if="$(arg rviz_putn)">
        <node name="rviz" pkg="rviz" type="rviz"
            args="-d $(find putn_launch)/rviz_config/simulation.rviz" required="false" />
    </group>

    <node name="local_planner" pkg="local_planner" type="local_planner.py" output="log"
        required="true" />

    <node name="controller" pkg="local_planner" type="controller.py" output="log" />

</launch>