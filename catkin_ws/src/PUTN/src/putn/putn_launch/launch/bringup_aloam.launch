<launch>
    <arg name="rviz_aloam" default="false" />
    <arg name="use_sim_time" default="true" />
    <arg name="mapping_line_resolution" default="0.1" />
    <arg name="mapping_plane_resolution" default="0.3" />
    <arg name="mapping_skip_frame" default="1" />

    <param name="/use_sim_time" value="$(arg use_sim_time)" />

    <include file="$(find aloam_velodyne)/launch/aloam_ouster_128.launch">
        <arg name="rviz" value="$(arg rviz_aloam)" />
        <arg name="mapping_line_resolution" value="$(arg mapping_line_resolution)" />
        <arg name="mapping_plane_resolution" value="$(arg mapping_plane_resolution)" />
        <arg name="mapping_skip_frame" value="$(arg mapping_skip_frame)" />
    </include>


    <!-- <node pkg="tf" type="static_transform_publisher" name="world_to_camera_init" args="0 0 0 0 0 0 /world /camera_init 10" />10ms -->
    <!-- <node pkg="tf" type="static_transform_publisher" name="camera_to_link" args="0 0 -0.4 0 0 0 /aft_mapped /base_link 10" /> -->

    <!-- <node pkg="tf" type="static_transform_publisher" name="glim_map_to_putn_world" args="0 0 0 0 0 0 /map /world 10" />
    <node pkg="tf" type="static_transform_publisher" name="glim_odom_to_putn_camera_init" args="0 0 0 0 0 0 /odom /camera_init 10" />
    <node pkg="tf" type="static_transform_publisher" name="putn_aft_mapped_to_base_link" args="0 0 0 0 0 0 /aft_mapped /base_link 10" /> -->

</launch>