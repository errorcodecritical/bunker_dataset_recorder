<?xml version="1.0"?>
<package format="2">
  <name>image_space_path_planning</name>
  <version>0.0.1</version>
  <description>ROS package for image-space path planning using OpenCV and Eigen.</description>

  <maintainer email="afonso.carvalho@isr.uc.pt">Afonso Carvalho</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Unified dependency declarations -->
  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>image_transport</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <test_depend>rostest</test_depend>
  <test_depend>gtest</test_depend>

  <!-- Optional URL tags -->
  <url type="website">http://wiki.ros.org/image_space_path_planning</url>

  <export>
  </export>
</package>