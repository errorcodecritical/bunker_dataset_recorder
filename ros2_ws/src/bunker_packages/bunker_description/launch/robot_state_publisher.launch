<launch>
  <arg name="use_sim_time" default="false" />
  <arg name="simulation" default="false" />
  <arg name="gui" default="false" />

  <param name="use_sim_time" value="$(arg use_sim_time)" />
  <param name="robot_description" command="$(find xacro)/xacro $(find bunker_description)/urdf/bunker.urdf.xacro use_sim_time:=$(arg use_sim_time) simulation:=$(arg simulation)" />

  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen" />

  <node pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" name="joint_state_publisher_gui" output="screen" if="$(arg gui)" />
  <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher" output="screen" unless="$(arg gui)" />
</launch>
