<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config" 
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <!-- Domain 0: Local-only via loopback and shared memory -->
  <Domain id="0">
    <General>
      <!-- Disable network multicast discovery across interfaces -->
      <AllowMulticast>false</AllowMulticast>
      
      <!-- Bind network traffic strictly to loopback -->
      <Interfaces>
        <NetworkInterface name="lo" multicast="false"/>
      </Interfaces>
    </General>

    <!-- Enforce Iceoryx shared memory zero-copy transport -->
    <SharedMemory/>
  </Domain>
</CycloneDDS>