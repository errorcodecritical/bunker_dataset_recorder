<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config" 
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain Id="30">
    
    <General>
      <!-- Enable multicast EXCLUSIVELY for SPDP auto-detection -->
      <AllowMulticast>spdp</AllowMulticast>

      <!-- Replaces NetworkInterfaceAddress -->
      <Interfaces>
        <NetworkInterface name="wlan0" priority="default" multicast="default"/>
      </Interfaces>
    </General>

    <Discovery>
      <SPDPMulticastAddress>239.255.0.1</SPDPMulticastAddress>
      <Peers>
        <Peer Address="239.255.0.1"/>
      </Peers>
    </Discovery>

    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
    </Internal>

    <SharedMemory/>

  </Domain>
</CycloneDDS>